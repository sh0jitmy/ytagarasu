# Dewy Agent Environment Configuration
# Copy to dewy.env and edit for your environment

# S3-compatible object storage settings
S3_BUCKET=your-bucket-name
S3_PREFIX=app
S3_ENDPOINT=https://s3.tky01.sakurastorage.jp
S3_REGION=jp-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Dewy agent settings
DEWY_ARTIFACT=app
DEWY_INTERVAL=10s
DEWY_PORT=:3000
