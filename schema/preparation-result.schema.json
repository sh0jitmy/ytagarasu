{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ytagarasu.internal/schemas/preparation-result.schema.json",
  "title": "YtagarasuPreparationResult",
  "description": "Schema for bundle generation evaluation report (preparation-result.yaml)",
  "type": "object",
  "required": [
    "version",
    "evaluatedAt",
    "status",
    "application",
    "release",
    "target",
    "requiredFiles",
    "resourceEstimates"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "warning", "blocked"]
    },
    "application": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "required": ["os", "version", "arch"],
      "properties": {
        "os": { "type": "string" },
        "version": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "requiredFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "exists"],
        "properties": {
          "path": { "type": "string" },
          "exists": { "type": "boolean" },
          "sha256": { "type": "string" }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "reason"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "resourceEstimates": {
      "type": "object",
      "required": [
        "bundleSizeBytes",
        "installedSizeBytes",
        "requiredDiskFreeBytes"
      ],
      "properties": {
        "bundleSizeBytes": { "type": "integer" },
        "installedSizeBytes": { "type": "integer" },
        "requiredDiskFreeBytes": { "type": "integer" }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "description", "mitigation"],
        "properties": {
          "id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    }
  }
}
